namespace cashbuddy {
    SmsTransaction? parse_sms(string sender, string body);
    void learn_trusted_sender(string sender);
    boolean is_trusted_sender(string sender);
    ScreenshotTransaction? parse_screenshot_text(string raw_text);
    boolean is_duplicate_transaction(double amount1, string merchant1, i64 time1, double amount2, string merchant2, i64 time2, i64 window_secs);
};

enum TransactionType {
    "Debit",
    "Credit"
};

dictionary SmsTransaction {
    double amount;
    TransactionType transaction_type;
    string category;
    string merchant;
    string? account_last4;
    string? bank;
    string raw_text;
    float confidence;
    i64 timestamp;
};

dictionary ScreenshotTransaction {
    double amount;
    TransactionType transaction_type;
    string merchant;
    string category;
    string? utr_or_ref;
    string app_name;
    float confidence;
    string raw_text;
};

enum Category {
    "Food",
    "Transport",
    "Shopping",
    "Bills",
    "Entertainment",
    "Health",
    "Education",
    "Housing",
    "Insurance",
    "Investments",
    "Salary",
    "Refund",
    "Gift",
    "Unknown"
};

dictionary ParsedTransaction {
    double amount;
    TransactionType transaction_type;
    Category category;
    string merchant;
    string? account_id;
    string source_app;
    string raw_text;
    float confidence;
    i64 timestamp;
};

dictionary RawNotification {
    string package_name;
    string title;
    string text;
    i64 timestamp;
};

[Error]
enum CoreError {
    "ModelLoadError",
    "InferenceError",
    "DecryptionFailed",
    "EncryptionFailed",
    "InvalidKey",
    "ParseError",
    "TokenizerError"
};

interface NotificationParser {
    constructor();
    ParsedTransaction? parse(RawNotification notification);
};

dictionary CategoryMatch {
    string category;
    float confidence;
    string source;
};

dictionary MerchantRuleEntry {
    string merchant;
    string category;
};

interface CategoryEngine {
    constructor();
    void load_user_rules(sequence<MerchantRuleEntry> rules);
    void learn_correction(string merchant, string category);
    CategoryMatch get_category(string merchant);
};

dictionary EncryptedData {
    sequence<u8> ciphertext;
    sequence<u8> nonce;
};

interface CryptoManager {
    constructor();
    sequence<u8> generate_key();
    [Throws=CoreError]
    EncryptedData encrypt(sequence<u8> plaintext, sequence<u8> key);
    [Throws=CoreError]
    sequence<u8> decrypt(EncryptedData data, sequence<u8> key);
    sequence<u8> derive_key(string passphrase, sequence<u8> salt);
};

interface SecurityValidator {
    constructor();
    boolean is_device_compromised();
};
