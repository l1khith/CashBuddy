('Bills & Utilities', 'EXPENSE', 'receipt', '#96CEB4', 1, 4, ?),
('Entertainment', 'EXPENSE', 'movie', '#DDA0DD', 1, 5, ?),
('Healthcare', 'EXPENSE', 'local_hospital', '#F7DC6F', 1, 6, ?),
('Education', 'EXPENSE', 'school', '#BB8FCE', 1, 7, ?),
('Housing', 'EXPENSE', 'home', '#E74C3C', 1, 8, ?),
