CREATE TABLE learned_token (
    token TEXT PRIMARY KEY NOT NULL,
    transaction_count INTEGER NOT NULL DEFAULT 0,
    non_transaction_count INTEGER NOT NULL DEFAULT 0,
    first_seen INTEGER NOT NULL,
    last_updated INTEGER NOT NULL
);

CREATE INDEX idx_learned_token_counts
    ON learned_token(transaction_count, non_transaction_count);

getByToken:
SELECT * FROM learned_token WHERE token = ?;

getAll:
SELECT * FROM learned_token;

getSignificant:
SELECT * FROM learned_token
WHERE transaction_count + non_transaction_count >= 5;

getTopSignificant:
SELECT * FROM learned_token
WHERE transaction_count + non_transaction_count >= 5
ORDER BY (transaction_count + non_transaction_count) DESC
LIMIT :limit;

getByTokens:
SELECT * FROM learned_token
WHERE token IN :tokens;

getCount:
SELECT COUNT(*) FROM learned_token;

purgeOldestLeastUsed:
DELETE FROM learned_token
WHERE token IN (
    SELECT token FROM learned_token
    ORDER BY (transaction_count + non_transaction_count) ASC, last_updated ASC
    LIMIT :excess
);

incrementTransaction:
INSERT OR REPLACE INTO learned_token (token, transaction_count, non_transaction_count,
                                      first_seen, last_updated)
VALUES (
    :token,
    COALESCE((SELECT transaction_count FROM learned_token WHERE token = :token), 0) + 1,
    COALESCE((SELECT non_transaction_count FROM learned_token WHERE token = :token), 0),
    COALESCE((SELECT first_seen FROM learned_token WHERE token = :token), :first_seen),
    :last_updated
);

incrementNonTransaction:
INSERT OR REPLACE INTO learned_token (token, transaction_count, non_transaction_count,
                                      first_seen, last_updated)
VALUES (
    :token,
    COALESCE((SELECT transaction_count FROM learned_token WHERE token = :token), 0),
    COALESCE((SELECT non_transaction_count FROM learned_token WHERE token = :token), 0) + 1,
    COALESCE((SELECT first_seen FROM learned_token WHERE token = :token), :first_seen),
    :last_updated
);

deleteAll:
DELETE FROM learned_token;
