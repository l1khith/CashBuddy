CREATE TABLE recurring_pattern (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    merchant_normalized TEXT NOT NULL,
    amount_paise INTEGER NOT NULL,
    occurrence_count INTEGER NOT NULL,
    median_interval_hours REAL NOT NULL,
    cv REAL NOT NULL,
    period_hours INTEGER NOT NULL,
    autocorrelation_peak REAL NOT NULL,
    first_seen INTEGER NOT NULL,
    last_seen INTEGER NOT NULL,
    last_updated INTEGER NOT NULL,
    UNIQUE(merchant_normalized, amount_paise)
);

CREATE INDEX idx_pattern_merchant ON recurring_pattern(merchant_normalized);
CREATE INDEX idx_pattern_amount ON recurring_pattern(amount_paise);

upsert:
INSERT OR REPLACE INTO recurring_pattern (
    merchant_normalized,
    amount_paise,
    occurrence_count,
    median_interval_hours,
    cv,
    period_hours,
    autocorrelation_peak,
    first_seen,
    last_seen,
    last_updated
) VALUES (
    :merchantNormalized,
    :amountPaise,
    :occurrenceCount,
    :medianIntervalHours,
    :cv,
    :periodHours,
    :autocorrelationPeak,
    :firstSeen,
    :lastSeen,
    :lastUpdated
);

getAll:
SELECT * FROM recurring_pattern
ORDER BY last_updated DESC;

findByMerchantAndAmount:
SELECT * FROM recurring_pattern
WHERE merchant_normalized = :merchantNormalized AND amount_paise = :amountPaise
LIMIT 1;

deleteById:
DELETE FROM recurring_pattern
WHERE id = :id;

deleteAll:
DELETE FROM recurring_pattern;

deleteStale:
DELETE FROM recurring_pattern
WHERE last_updated < :staleBefore;
